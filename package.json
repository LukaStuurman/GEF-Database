{
  "name": "gef-viewer-desktop",
  "description": "Windows desktop application for viewing Geotechnical Exchange Format (GEF) files",
  "homepage": "https://github.com/LukaStuurman/GEF-Database",
  "version": "1.4.1",
  "main": "electron/main.cjs",
  "author": {
    "name": "Jules Blom",
    "url": "https://bedrock.engineer",
    "email": "jules.blom@bedrock.engineer"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LukaStuurman/GEF-Database.git"
  },
  "bugs": {
    "url": "https://github.com/LukaStuurman/GEF-Database/issues"
  },
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "desktop:dev": "concurrently -k \"npm run dev\" \"npm run electron:dev\"",
    "electron:dev": "wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder --win",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app/components app/locales app/util src vite.config.ts",
    "format": "prettier -w app/components app/locales app/util src electron vite.config.ts index.html",
    "knip": "knip"
  },
  "dependencies": {},
  "devDependencies": {
    "@bedrock-engineer/gef-parser": "^0.1.3-beta.2",
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.1.17",
    "@types/d3-array": "^3.2.1",
    "@types/d3-dsv": "^3.0.7",
    "@types/d3-format": "^3.0.4",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.0",
    "@observablehq/plot": "^0.6.17",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "d3-array": "^3.2.4",
    "d3-dsv": "^3.0.1",
    "d3-format": "^3.1.0",
    "electron": "^37.6.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "html2canvas": "^1.4.1",
    "i18next": "^25.6.3",
    "i18next-browser-languagedetector": "^8.2.0",
    "jspdf": "^3.0.3",
    "knip": "^5.70.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.554.0",
    "prettier": "^3.6.2",
    "react": "^19.2.4",
    "react-aria-components": "^1.15.1",
    "react-dom": "^19.2.4",
    "react-i18next": "^16.3.5",
    "svg-crowbar": "^0.7.0",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vite": "^7.3.1",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "engineer.bedrock.gefdesktop",
    "productName": "GEF Viewer Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "public/favicon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "prettier": {
    "semi": true,
    "trailingComma": "all",
    "singleQuote": false,
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf"
  }
}
